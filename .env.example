# Copy this to .env and fill in real values. .env itself is gitignored.

# 32-byte (64 hex character) key used to encrypt the saved Indeed session.
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Used to draft answers to open-ended screening questions — strictly
# grounded in profile.json, never invents experience. See PLANNING.md.
KIMI_API_KEY=
